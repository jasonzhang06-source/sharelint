  "format_version": 2,
  "target_static_rules": {
    "linux-glibc-x86_64": [
      {
        "component": "mimalloc",
        "match": "@always",
        "origin": "CPython 3.13.15 core",
        "version": "2.1.2"
      },
      {
        "component": "libmpdec",
        "match": "_decimal*.so",
        "origin": "CPython 3.13.15 bundled extension",
        "version": "2.5.1"
      },
      {
        "component": "expat",
        "match": "pyexpat*.so",
        "origin": "CPython 3.13.15 vendored extension",
        "version": "2.8.2"
      }
    ],
    "macos-arm64": [
      {
        "component": "xz-utils",
        "match": "_lzma*.so",
        "origin": "CPython 3.13.15 macOS installer",
        "version": "5.2.3"
      },
      {
        "component": "libmpdec",
        "match": "_decimal*.so",
        "origin": "CPython 3.13.15 macOS installer",
        "version": "4.0.1"
      },
      {
        "component": "expat",
        "match": "pyexpat*.so",
        "origin": "CPython 3.13.15 vendored extension",
        "version": "2.8.2"
      },
      {
        "component": "sqlite",
        "match": "_sqlite3*.so",
        "origin": "CPython 3.13.15 macOS installer",
        "version": "3.50.4"
      }
    ],
    "macos-x86_64": [
      {
        "component": "xz-utils",
        "match": "_lzma*.so",
        "origin": "CPython 3.13.15 macOS installer",
        "version": "5.2.3"
      },
      {
        "component": "libmpdec",
        "match": "_decimal*.so",
        "origin": "CPython 3.13.15 macOS installer",
        "version": "4.0.1"
      },
      {
        "component": "expat",
        "match": "pyexpat*.so",
        "origin": "CPython 3.13.15 vendored extension",
        "version": "2.8.2"
      },
      {
        "component": "sqlite",
        "match": "_sqlite3*.so",
        "origin": "CPython 3.13.15 macOS installer",
        "version": "3.50.4"
      }
    ],
    "windows-x86_64": [
      {
        "component": "zlib",
        "match": "@always",
        "origin": "PyInstaller 6.22.2 Windows bootloader",
        "version": "1.3.2"
      },
      {
        "component": "mimalloc",
        "match": "@always",
        "origin": "CPython 3.13.15 core",
        "version": "2.1.2"
      },
      {
        "component": "zlib",
        "match": "@always",
        "origin": "CPython 3.13.15 Windows core",
        "version": "1.3.1"
      },
      {
        "component": "bzip2",
        "match": "_bz2*.pyd",
        "origin": "CPython 3.13.15 Windows extension",
        "version": "1.0.8"
      },
      {
        "component": "xz-utils",
        "match": "_lzma*.pyd",
        "origin": "CPython 3.13.15 Windows extension",
        "version": "5.2.5"
      },
      {
        "component": "libmpdec",
        "match": "_decimal*.pyd",
        "origin": "CPython 3.13.15 Windows extension",
        "version": "4.0.0"
      },
      {
        "component": "expat",
        "match": "pyexpat*.pyd",
        "origin": "CPython 3.13.15 vendored extension",
        "version": "2.8.2"
      },
      {
        "component": "expat",
        "match": "_elementtree*.pyd",
        "origin": "CPython 3.13.15 Windows extension",
        "version": "2.8.2"
      }
    ]
  }
