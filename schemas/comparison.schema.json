{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jasonzhang06-source/sharelint/v1.3.0/schemas/comparison.schema.json",
  "title": "ShareLint aggregate report comparison",
  "type": "object",
  "required": [
    "schema_version",
    "comparison_type",
    "decision",
    "before_sha256",
    "after_sha256",
    "fail_on",
    "before",
    "after",
    "changes",
    "review_reasons",
    "scope",
    "claim"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "comparison_type": {
      "const": "sharelint.aggregate-diff"
    },
    "decision": {
      "enum": [
        "no-regression-observed",
        "regression-observed",
        "review-required"
      ]
    },
    "before_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "after_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "fail_on": {
      "$ref": "#/$defs/severity"
    },
    "before": {
      "$ref": "#/$defs/summary"
    },
    "after": {
      "$ref": "#/$defs/summary"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "severity",
          "before",
          "after",
          "delta"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^(?:SL\\.[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*|unrecognized-rule)$"
          },
          "severity": {
            "$ref": "#/$defs/severity"
          },
          "before": {
            "type": "integer",
            "minimum": 0
          },
          "after": {
            "type": "integer",
            "minimum": 0
          },
          "delta": {
            "type": "integer",
            "not": {
              "const": 0
            }
          }
        },
        "additionalProperties": false
      }
    },
    "review_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "producer-version-changed",
          "resource-limits-changed",
          "recorded-threshold-changed",
          "target-kind-changed",
          "current-coverage-incomplete",
          "empty-surface-records",
          "surface-count-decreased",
          "inspected-byte-count-decreased",
          "unrecognized-rules-grouped",
          "blocking-rule-count-increased",
          "coverage-gaps-increased"
        ]
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "method",
        "matched_values_compared",
        "filenames_compared"
      ],
      "properties": {
        "method": {
          "const": "rule-severity-counts"
        },
        "matched_values_compared": {
          "const": false
        },
        "filenames_compared": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "verdict",
        "fail_on",
        "blocking_findings",
        "total_findings",
        "findings_by_severity",
        "surface_count",
        "surfaces_by_status",
        "bytes_inspected",
        "error_count",
        "coverage_complete"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "blocked",
            "incomplete"
          ]
        },
        "fail_on": {
          "$ref": "#/$defs/severity"
        },
        "blocking_findings": {
          "type": "integer",
          "minimum": 0
        },
        "total_findings": {
          "type": "integer",
          "minimum": 0
        },
        "findings_by_severity": {
          "type": "object",
          "required": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "properties": {
            "info": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "critical": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "surface_count": {
          "type": "integer",
          "minimum": 0
        },
        "surfaces_by_status": {
          "type": "object",
          "required": [
            "scanned",
            "partial",
            "skipped"
          ],
          "properties": {
            "scanned": {
              "type": "integer",
              "minimum": 0
            },
            "partial": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "bytes_inspected": {
          "type": "integer",
          "minimum": 0
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
