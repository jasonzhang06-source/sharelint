{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jasonzhang06-source/sharelint/v2.1.0/schemas/batch.schema.json",
  "title": "ShareLint private aggregate batch preflight",
  "type": "object",
  "required": [
    "schema_version",
    "batch_type",
    "tool",
    "status",
    "fail_on",
    "require_complete_coverage",
    "batch_limits",
    "scan_limits",
    "summary",
    "entries",
    "claim"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "batch_type": {
      "const": "sharelint.batch-preflight"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "sharelint"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "pass",
        "blocked",
        "incomplete",
        "error"
      ]
    },
    "fail_on": {
      "$ref": "#/$defs/severity"
    },
    "require_complete_coverage": {
      "const": true
    },
    "batch_limits": {
      "type": "object",
      "required": [
        "max_targets",
        "max_total_bytes"
      ],
      "properties": {
        "max_targets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "additionalProperties": false
    },
    "scan_limits": {
      "$ref": "#/$defs/limits"
    },
    "summary": {
      "type": "object",
      "required": [
        "target_count",
        "targets_by_status",
        "charged_bytes",
        "coverage_complete"
      ],
      "properties": {
        "target_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "targets_by_status": {
          "type": "object",
          "required": [
            "pass",
            "blocked",
            "incomplete",
            "error",
            "not-scanned"
          ],
          "properties": {
            "pass": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "blocked": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "incomplete": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "error": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "not-scanned": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          },
          "additionalProperties": false
        },
        "charged_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "coverage_complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "target_id",
          "status",
          "reason",
          "charged_bytes",
          "target_sha256",
          "report_sha256",
          "effective_limits",
          "summary",
          "rules"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^t[0-9]{4}$"
          },
          "status": {
            "enum": [
              "pass",
              "blocked",
              "incomplete",
              "error",
              "not-scanned"
            ]
          },
          "reason": {
            "enum": [
              "complete",
              "policy-block",
              "coverage-gap",
              "input-error",
              "batch-byte-limit"
            ]
          },
          "charged_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "target_sha256": {
            "anyOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "report_sha256": {
            "anyOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "effective_limits": {
            "anyOf": [
              {
                "$ref": "#/$defs/limits"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/$defs/summary"
              },
              {
                "type": "null"
              }
            ]
          },
          "rules": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "required": [
                "rule_id",
                "severity",
                "count"
              ],
              "properties": {
                "rule_id": {
                  "type": "string",
                  "pattern": "^SL\\.[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*$"
                },
                "severity": {
                  "$ref": "#/$defs/severity"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "claim": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "sharelint"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "max_file_bytes",
        "max_member_bytes",
        "max_total_bytes",
        "max_archive_depth",
        "max_archive_members",
        "max_compression_ratio",
        "max_text_chars",
        "max_xml_elements",
        "max_findings"
      ],
      "properties": {
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_member_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_archive_depth": {
          "type": "integer",
          "minimum": 1
        },
        "max_archive_members": {
          "type": "integer",
          "minimum": 1
        },
        "max_compression_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_text_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_xml_elements": {
          "type": "integer",
          "minimum": 1
        },
        "max_findings": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "verdict",
        "fail_on",
        "blocking_findings",
        "total_findings",
        "findings_by_severity",
        "surface_count",
        "surfaces_by_status",
        "bytes_inspected",
        "error_count",
        "coverage_complete"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "blocked",
            "incomplete"
          ]
        },
        "fail_on": {
          "$ref": "#/$defs/severity"
        },
        "blocking_findings": {
          "type": "integer",
          "minimum": 0
        },
        "total_findings": {
          "type": "integer",
          "minimum": 0
        },
        "findings_by_severity": {
          "type": "object",
          "required": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "properties": {
            "info": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "critical": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "surface_count": {
          "type": "integer",
          "minimum": 0
        },
        "surfaces_by_status": {
          "type": "object",
          "required": [
            "scanned",
            "partial",
            "skipped"
          ],
          "properties": {
            "scanned": {
              "type": "integer",
              "minimum": 0
            },
            "partial": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "bytes_inspected": {
          "type": "integer",
          "minimum": 0
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
