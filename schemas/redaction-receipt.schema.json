{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jasonzhang06-source/sharelint/v3.0.0/schemas/redaction-receipt.schema.json",
  "title": "ShareLint text derivative receipt",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_type",
    "status",
    "tool",
    "created_at",
    "source",
    "output",
    "plan",
    "policy",
    "require_no_findings",
    "edit_count",
    "summary",
    "report_sha256",
    "verification",
    "claim"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_type": {
      "const": "sharelint.text-redaction"
    },
    "status": {
      "const": "applied"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "sharelint"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source": {
      "type": "object",
      "required": [
        "sha256",
        "size"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "sha256",
        "size"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        }
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": [
        "sha256",
        "document_sha256"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "document_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "sha256",
        "ruleset_sha256",
        "fail_on",
        "require_complete_coverage",
        "limits"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ruleset_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fail_on": {
          "$ref": "#/$defs/severity"
        },
        "require_complete_coverage": {
          "const": true
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "additionalProperties": false
    },
    "require_no_findings": {
      "const": true
    },
    "edit_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "verification": {
      "type": "object",
      "required": [
        "source_rechecked",
        "reopened_and_rescanned",
        "coverage_complete"
      ],
      "properties": {
        "source_rechecked": {
          "const": true
        },
        "reopened_and_rescanned": {
          "const": true
        },
        "coverage_complete": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "sharelint"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "max_file_bytes",
        "max_member_bytes",
        "max_total_bytes",
        "max_archive_depth",
        "max_archive_members",
        "max_compression_ratio",
        "max_text_chars",
        "max_xml_elements",
        "max_findings"
      ],
      "properties": {
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_member_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_archive_depth": {
          "type": "integer",
          "minimum": 1
        },
        "max_archive_members": {
          "type": "integer",
          "minimum": 1
        },
        "max_compression_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_text_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_xml_elements": {
          "type": "integer",
          "minimum": 1
        },
        "max_findings": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "verdict",
        "fail_on",
        "blocking_findings",
        "total_findings",
        "findings_by_severity",
        "surface_count",
        "surfaces_by_status",
        "bytes_inspected",
        "error_count",
        "coverage_complete"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "blocked",
            "incomplete"
          ]
        },
        "fail_on": {
          "$ref": "#/$defs/severity"
        },
        "blocking_findings": {
          "type": "integer",
          "minimum": 0
        },
        "total_findings": {
          "type": "integer",
          "minimum": 0
        },
        "findings_by_severity": {
          "type": "object",
          "required": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "properties": {
            "info": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "critical": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "surface_count": {
          "type": "integer",
          "minimum": 0
        },
        "surfaces_by_status": {
          "type": "object",
          "required": [
            "scanned",
            "partial",
            "skipped"
          ],
          "properties": {
            "scanned": {
              "type": "integer",
              "minimum": 0
            },
            "partial": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "bytes_inspected": {
          "type": "integer",
          "minimum": 0
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
